# ─── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/tarifaia_db

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ─── Autenticación JWT ────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Almacenamiento de archivos ───────────────────────────
STORAGE_DOCUMENTOS=./storage/documentos
STORAGE_PLANTILLAS=./storage/plantillas

# ─── Aplicación ───────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
